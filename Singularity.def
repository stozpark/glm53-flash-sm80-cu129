Bootstrap: docker
From: vllm/vllm-openai:glm53-flash-cu129

%labels
    Maintainer stozpark
    Purpose GLM-5.3-Flash CUDA12.9 SM80 sparse-MLA patch
    PR47629 064801dd2bc6ac2e265dc3fa1f5d803d71bde25d
    PR54031 b325d908656d05e2a650ec60666ccec6f4f3eb0c
    Mrzhiyao daeccb983ec84756cde7408b0e29161d492ea2c5

%files
    vendor /opt/glm53-sm80/vendor
    patch_47644_compat.py /opt/glm53-sm80/patch_47644_compat.py
    patch_runtime.py /opt/glm53-sm80/patch_runtime.py
    patch_cuda_sparse_priority.py /opt/glm53-sm80/patch_cuda_sparse_priority.py
    patch_deepgemm_gate.py /opt/glm53-sm80/patch_deepgemm_gate.py
    patch_kpool_topk_len.py /opt/glm53-sm80/patch_kpool_topk_len.py
    patch_mrzhiyao_merge.py /opt/glm53-sm80/patch_mrzhiyao_merge.py
    patch_glm53_tail.py /opt/glm53-sm80/patch_glm53_tail.py
    verify_static.py /opt/glm53-sm80/verify_static.py

%post
    set -eu
    test -s /opt/glm53-sm80/vendor/MANIFEST.txt
    echo "=== vendor manifest ==="
    cat /opt/glm53-sm80/vendor/MANIFEST.txt

    PYTHON_BIN="$(command -v python3 || command -v python)"
    test -n "${PYTHON_BIN}"
    echo "PYTHON_BIN=${PYTHON_BIN}"

    VLLM_ROOT="$(${PYTHON_BIN} -c 'import pathlib, vllm; print(pathlib.Path(vllm.__file__).resolve().parent)')"
    echo "VLLM_ROOT=${VLLM_ROOT}"
    "${PYTHON_BIN}" -c 'import vllm; print("BASE_VLLM_VERSION=" + vllm.__version__)'

    "${PYTHON_BIN}" /opt/glm53-sm80/patch_47644_compat.py --vllm-root "${VLLM_ROOT}"
    "${PYTHON_BIN}" /opt/glm53-sm80/patch_runtime.py \
      --vllm-root "${VLLM_ROOT}" --vendor /opt/glm53-sm80/vendor \
      --backup-root /opt/glm53-sm80/stock
    "${PYTHON_BIN}" /opt/glm53-sm80/patch_cuda_sparse_priority.py --vllm-root "${VLLM_ROOT}"
    "${PYTHON_BIN}" /opt/glm53-sm80/patch_deepgemm_gate.py --vllm-root "${VLLM_ROOT}"
    "${PYTHON_BIN}" /opt/glm53-sm80/patch_kpool_topk_len.py --vllm-root "${VLLM_ROOT}"
    "${PYTHON_BIN}" /opt/glm53-sm80/patch_mrzhiyao_merge.py \
      --vllm-root "${VLLM_ROOT}" --vendor /opt/glm53-sm80/vendor
    "${PYTHON_BIN}" /opt/glm53-sm80/patch_glm53_tail.py \
      --vllm-root "${VLLM_ROOT}" --vendor /opt/glm53-sm80/vendor
    "${PYTHON_BIN}" /opt/glm53-sm80/verify_static.py --vllm-root "${VLLM_ROOT}"

    cp /opt/glm53-sm80/vendor/MANIFEST.txt /opt/glm53-sm80/BUILD_MANIFEST.txt
    "${PYTHON_BIN}" -c 'import vllm; print(vllm.__version__)' > /opt/glm53-sm80/BASE_VLLM_VERSION.txt

%environment
    export PYTHONUNBUFFERED=1

%runscript
    exec vllm "$@"
