Bootstrap: docker
From: vllm/vllm-openai:v0.30.0

%files
    patch_glm53_full_sm80.py /opt/glm53-full-sm80/patch_glm53_full_sm80.py
    vendor/glm53-full-sm80 /opt/glm53-full-sm80/vendor/glm53-full-sm80
    tests/sm80_glm53_full_kernel_smoke.py /opt/glm53-full-sm80/sm80_glm53_full_kernel_smoke.py

%post
    set -eux
    PYTHON_BIN="$(command -v python3 || command -v python)"
    VLLM_ROOT="$("${PYTHON_BIN}" - <<'PY'
import pathlib, vllm
print(pathlib.Path(vllm.__file__).resolve().parent)
PY
)"
    "${PYTHON_BIN}" /opt/glm53-full-sm80/patch_glm53_full_sm80.py \
        --vllm-root "${VLLM_ROOT}" \
        --vendor /opt/glm53-full-sm80/vendor/glm53-full-sm80
    "${PYTHON_BIN}" -m py_compile \
        "${VLLM_ROOT}/v1/attention/backends/registry.py" \
        "${VLLM_ROOT}/platforms/cuda.py" \
        "${VLLM_ROOT}/v1/attention/backends/mla/indexer.py" \
        "${VLLM_ROOT}/model_executor/layers/sparse_attn_indexer.py" \
        "${VLLM_ROOT}/models/deepseek_v32/nvidia/model.py" \
        "${VLLM_ROOT}/models/deepseek_v32/attention.py" \
        "${VLLM_ROOT}/models/deepseek_v32/common/kernels.py" \
        "${VLLM_ROOT}/v1/attention/backends/mla/triton_mla_sparse.py" \
        "${VLLM_ROOT}/v1/attention/ops/mqa_logits_triton.py" \
        "${VLLM_ROOT}/v1/attention/ops/triton_mla_sparse_kernel.py"
    grep -q TRITON_MLA_SPARSE "${VLLM_ROOT}/platforms/cuda.py"
    grep -q SM80_PIECEWISE_KV_BINDING_FIX "${VLLM_ROOT}/models/deepseek_v32/attention.py"
    ! grep -q _sm80_pp_topk_relay_buf "${VLLM_ROOT}/models/deepseek_v32/nvidia/model.py"
    grep -q _encode_e4m3fn_u8 "${VLLM_ROOT}/models/deepseek_v32/common/kernels.py"
    echo GLM53_FULL_SM80_STATIC=PASS
